# Copy this file to settings.ini (same folder) and edit the values.
# settings.ini is never committed: it holds your own paths and URLs.

# Folder that holds one sub-folder per project (each with a note.md).
projects_folder=C:\Users\YOUR-NAME\Desktop\projects

# Base URL of your Jira, used by "Open in Jira" (it adds /browse/TICKET-ID).
jira_url=https://jira.example.com

# Claude model used by Ask Claude. Empty or missing = claude-sonnet-5-5.
# The login is NOT here: it comes from environment variables
# (ANTHROPIC_API_KEY at home, ANTHROPIC_AUTH_TOKEN + ANTHROPIC_BASE_URL at work).
model=claude-sonnet-5-5

# Most text Ask Claude reads per question, in characters (about 1 character = 1 byte).
# Empty or missing = 200000 (about $0.10 per question on Sonnet; double it = double the cost).
# Raise it if the chat says "Not read: ... over the limit". Whole number, no commas.
text_limit=200000

# ----- Slack button -----
# The login is NOT here: it comes from environment variables SLACK_USER_TOKEN (xoxp-…, reads your
# messages) and SLACK_APP_TOKEN (xapp-…, lets Slack push new messages at once). No SLACK_USER_TOKEN
# = the button says "not connected" and the rest of the app works as usual.

# instant = Slack pushes new messages to the app within seconds (needs SLACK_APP_TOKEN).
# backup  = the app asks Slack every slack_poll_seconds instead (use it if the work network blocks instant).
# Empty or missing = instant.
slack_mode=instant

# Backup mode: seconds between checks. Empty or missing = 30. Smallest = 5.
slack_poll_seconds=30

# On start (and after a lost connection), how many days back to look for unread mentions.
# Unread DMs are found whatever their age. Empty or missing = 7.
slack_lookback_days=7

# Make the button glow for messages from bots and apps (Jira, CI...)? yes or no. Missing = yes.
slack_count_bots=yes

# Make it glow for @here, @channel and @everyone? yes or no. Missing = yes.
slack_count_here=yes

# Make it glow for mentions of groups you are in (like @rf-team)? yes or no. Missing = yes.
slack_count_groups=yes
