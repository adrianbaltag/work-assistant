{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "timeout": 30,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "session-start"] } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "timeout": 30,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "prompt"] } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "timeout": 30,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "gate"] } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "timeout": 30,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "after-edit"] } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 30,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "stop"] } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "timeout": 10,
          "command": "python",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py", "session-end"] } ] }
    ]
  }
}
